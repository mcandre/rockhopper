#!/bin/bash
unset IFS
set -euo pipefail

rocklet_log_level="${rocklet_log_level:-info}"
rocklet_image="${rocklet_image:-unknown image}"
rocklet_mount_path="${rocklet_mount_path:-/mnt/rockhopper}"
rocklet_name="${rocklet_name:-}"
rocklet_version="${rocklet_version:-}"
rocklet_rev="${rocklet_rev:-}"
rocklet_maintainer="${rocklet_maintainer:-}"
rocklet_dependencies="${rocklet_dependencies:-}"
rocklet_copyright="${rocklet_copyright:-}"
rocklet_license="${rocklet_license:-}"
rocklet_summary="${rocklet_summary:-}"
rocklet_description="${rocklet_description:-}"
rocklet_templates="${rocklet_templates:-"$HOME/templates"}"
rocklet_cache="${rocklet_cache:-"$rocklet_mount_path/.rockhopper"}"
rocklet_pkg_build="${rocklet_pkg_build:-/tmp/openbsd}"
rocklet_os_arch="${rocklet_os_arch:-*}"
rocklet_pkgpath="${rocklet_pkgpath:-}"
rocklet_pkg_version="${rocklet_pkg_version:-}"

default_artifact="$rocklet_cache/artifacts/openbsd"

if [ "$rocklet_os_arch" = '*' ]; then
    default_artifact="${default_artifact}-all"
else
    default_artifact="${default_artifact}-${rocklet_os_arch}"
fi

rocklet_artifact="${rocklet_artifact:-"$default_artifact"}"

# Forward rockhopper environment variables to Jinja
for K in $(compgen -v | grep '^rocklet_'); do
    export "$K"
done

usage() {
    printf "Usage: %s [<OPTION>]\n" "$0"
    printf "\n"
    printf -- "--debug -d\tIncrease logging\n"
    printf -- "--quiet -q\tReduce logging\n"
    printf -- "--help -h\tShow usage menu\n"
    printf -- "--version -V\tShow version banner\n"
}

banner() {
    echo "$0 $ROCKHOPPER_VERSION"
}

while [ "$#" -ge 1 ]; do
    case "$1" in
    '--debug' | '-d')
        shift
        rocklet_log_level='debug'
        ;;
    '--quiet' | 'q')
        shift
        rocklet_log_level='quiet'
        ;;
    '--help' | '-h')
        usage
        exit
        ;;
    '--version' | '-V')
        banner
        exit
        ;;
    *)
        usage
        exit 1
        ;;
    esac
done

if [ "$rocklet_log_level" = 'debug' ]; then
    env | grep '^rocklet_' | sort
    set -x
fi

validate() {
    required_env_vars=(
        rocklet_artifact
        rocklet_cache
        rocklet_copyright
        rocklet_description
        rocklet_image
        rocklet_license
        rocklet_log_level
        rocklet_maintainer
        rocklet_mount_path
        rocklet_name
        rocklet_os_arch
        rocklet_pkg_build
        rocklet_pkg_version
        rocklet_pkgpath
        rocklet_summary
        rocklet_templates
        rocklet_version
    )

    for required_env_var in "${required_env_vars[@]}"; do
        eval "required_env_val=\$$required_env_var"

        if [ -z "$required_env_val" ]; then
            echo "error: ${rocklet_image} blank/missing env var: ${required_env_var}" >&2
            exit 1
        fi
    done
}

clean() {
    rm -rf "$rocklet_pkg_build"
}

validate
clean

source_media="$rocklet_cache/source-media"
mkdir -p "$source_media"

mkdir -p "${rocklet_pkg_build}/share/doc/${rocklet_name}"
LICENSE="${rocklet_pkg_build}/share/doc/${rocklet_name}/LICENSE"
rsubst --strict "$rocklet_templates/LICENSE.j2" >"$LICENSE"

if [ "$rocklet_log_level" = 'debug' ]; then
    echo 'LICENSE:'
    cat "$LICENSE"
fi

DESC="$rocklet_pkg_build/+DESC"
rsubst --strict "$rocklet_templates/+DESC.j2" >"$DESC"

if [ "$rocklet_log_level" = 'debug' ]; then
    echo '+DESC':
    cat "$DESC"
fi

export desc_sha256_base64="$(openssl dgst -sha256 -binary "$DESC" | openssl base64)"
export desc_b="$(stat -c %s "$DESC")"

cp -r "$source_media"/* "$rocklet_pkg_build"
chgrp -R bin "$rocklet_pkg_build"
chgrp wheel "$DESC"

cd "$rocklet_pkg_build"

openbsd_data=''

while IFS= read -r f; do
    f="${f#./}"

    if [ "$f" = '.' ] || [ "$f" = '+DESC' ]; then
        continue
    fi

    openbsd_data="${openbsd_data}${f}"

    if [ -d "$f" ]; then
        openbsd_data="${openbsd_data}/\n"
        continue
    fi

    f_sha256="$(openssl dgst -sha256 -binary "$f" | openssl base64)"
    f_b="$(stat -c %s "$f")"
    f_epoch="$(stat -c %Y "$f")"
    openbsd_data="${openbsd_data}\n@sha ${f_sha256}\n@size ${f_b}\n@ts ${f_epoch}\n"
done < <(find . | sort)

CONTENTS="$rocklet_pkg_build/+CONTENTS"
rsubst --strict "$rocklet_templates/+CONTENTS.j2" >"$CONTENTS"
printf "%b" "$openbsd_data" >>"$CONTENTS"
chgrp wheel "$CONTENTS"

if [ "$rocklet_log_level" = 'debug' ]; then
    echo '+CONTENTS':
    cat "$CONTENTS"
fi

artifact="$rocklet_artifact/${rocklet_name}-${rocklet_version}"

if [ -n "$rocklet_rev" ]; then
    artifact="${artifact}p${rocklet_rev}"
fi

artifact="$artifact.tgz"

cd "$rocklet_pkg_build"

tar_paths='/tmp/tar_paths.txt'

find . \
    -type f \
    -name '+*' \
    -mindepth 1 \
    -exec sh -c 'echo ${0#./}' "{}" \; |
    sort >"$tar_paths"

find . \
    -name '+*' -prune -o \
    -type f \
    -exec sh -c 'echo ${0#./}' "{}" \; |
    sort >>"$tar_paths"

if [ "$rocklet_log_level" = 'debug' ]; then
    echo 'tar_paths.txt:'
    cat "$tar_paths"
fi

mkdir -p "$rocklet_artifact"

bsdtar \
    --format=ustar \
    --no-xattrs \
    -c \
    -z \
    -f "$artifact" \
    -T "$tar_paths"

clean
